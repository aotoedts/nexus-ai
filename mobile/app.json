{
  "expo": {
    "name": "Copiloto AI",
    "slug": "isaias1t7",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexusai",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "O Copiloto AI precisa de reconhecimento de fala para converter sua voz em texto.",
        "NSMicrophoneUsageDescription": "O Copiloto AI precisa do microfone para ouvir seus comandos de voz."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "package": "com.nexusai",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera."
        }
      ],
      "expo-font",
      "./plugins/withAccessibilityService.js",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O Copiloto AI precisa do microfone para ouvir seus comandos de voz.",
          "speechRecognitionPermission": "O Copiloto AI precisa de reconhecimento de fala para converter sua voz em texto."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fea522f5-f8ce-4dbe-9609-977fa3629c90"
      }
    },
    "owner": "copilotoai"
  }
}
